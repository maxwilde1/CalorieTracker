# Ignore the main environment file.
# This can contain passwords and API keys.
.env

# Ignore other environment files, e.g. .env.local
# The * means "match anything after .env."
.env.*

# EXCEPTION: Allow .env.example to be tracked.
# The ! means "do NOT ignore this file".
# It can show which settings are needed without real passwords.
!.env.example

# Ignore downloaded JavaScript libraries.
# These can be reinstalled using npm install.
node_modules/

# Ignore temporary files generated by Expo.
.expo/

# Ignore files ending in .local.
# These may contain machine-specific settings.
*.local

# Ignore Arduino secrets stored in secrets.h.
# For example, your Wi-Fi password.
secrets.h